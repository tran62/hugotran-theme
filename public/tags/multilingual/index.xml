n.next();&#xA;    }&#xA;&#xA;  };&#xA;&#xA;  rendition.on(&#34;keyup&#34;, keyListener);&#xA;  document.addEventListener(&#34;keyup&#34;, keyListener, false);&#xA;  &#xA;&lt;/script&gt;&#xA;&#xA;&lt;/div&gt;</description>
